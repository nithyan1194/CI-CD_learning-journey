Step 5: Containerfile (Dockerfile)
Dockerfile

Dockerfile
# 1. Base image
FROM python:3.11-slim

# 2. Set working directory inside container
WORKDIR /app

# 3. Copy dependencies and install (leveraging Docker layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copy application source code
COPY app/ ./app

# 5. Expose application port
EXPOSE 5000

# 6. Default execution command
CMD ["python", "app/main.py"]
Step 6: GitHub Actions Workflow Definition
Create the workflow file inside .github/workflows/pipeline.yml.

.github/workflows/pipeline.yml

YAML
name: Build, Test, and Containerize

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  # JOB 1: Continuous Integration (Automated Testing)
  unit-tests:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4.2.2

      - name: Set up Python
        uses: actions/setup-python@v5.4.0
        with:
          python-version: '3.11'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run Pytest Suite
        run: |
          python -m pytest

  # JOB 2: Continuous Delivery (Docker Image Packaging)
  build-and-package:
    needs: unit-tests
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4.2.2

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3.10.0

      - name: Build Docker Image Locally (Validation)
        run: |
          docker build -t devops-flask-app:${{ github.sha }} .
          echo "Docker image built successfully with tag ${{ github.sha }}"
